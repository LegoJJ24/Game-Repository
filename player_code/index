extends CharacterBody2D

@export var hp: int = 10
@export var move_speed: int = 100

func _ready() -> void:
	pass



func _process(delta: float) -> void:
	
	var move_vector: Vector2 = Input.get_vector("move left", "move right", "move up", "move down")
	
	velocity = move_vector * move_speed
	
	if velocity.x > 0:
		$AnimatedSprite2D.play("Move Right")
	
	elif velocity.x < 0:
		$AnimatedSprite2D.play("Move Left")
	
	elif velocity.y > 0:
		$AnimatedSprite2D.play("Move Down")
	
	elif velocity.y < 0:
		$AnimatedSprite2D.play("Move Up")
	
	else:
		$AnimatedSprite2D.stop()
	
	
	move_and_slide()
